{
    "name": "bahdan/lead-capture-bundle",
    "description": "Lead and contact request capture bundle with dual Doctrine and JSONL storage",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Bahdan",
            "homepage": "https://bahdanhal.pl"
        }
    ],
    "require": {
        "php": ">=8.3",
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/orm": "^3.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bahdan\\LeadCaptureBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bahdan\\LeadCaptureBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
